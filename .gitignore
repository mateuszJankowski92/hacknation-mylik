# Sekrety: nigdy w repozytorium (wytyczne PRAWDOWID, s. 4)
.env
.env.*
!.env.example
*.pem
*.key

# Zależności i artefakty budowania
node_modules/
dist/
build/
coverage/
.vite/
*.tsbuildinfo

# Dane lokalne: bazy, logi przebiegu, pobrane surowe strony
data/*.sqlite
data/*.sqlite-*
data/*.db
logs/
*.log

# System i edytory
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Lokalne oceny właściciela (poza śledzonym review_sample_human.json) i indeks weryfikacji redakcji
data/eval/*_human.json
!data/eval/review_sample_human.json
data/raw/factcheck-index/
