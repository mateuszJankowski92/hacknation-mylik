# Skopiuj do .env i uzupełnij. Plik .env jest ignorowany przez git.
# Bez klucza system działa na atrapie modelu (LLM_PROVIDER=mock) i zgłasza
# stan techniczny, nigdy werdykt merytoryczny.

# Dostawca modelu: anthropic | mistral | mock
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

PORT=8787

# Model Anthropic (puste = domyślny ustalony w kodzie dostawcy)
ANTHROPIC_MODEL=

# Baza SQLite (korpus, rekordy, log zdarzeń)
DB_PATH=data/mylik.sqlite

# Limit żądań na minutę na klienta
RATE_LIMIT_PER_MIN=20

# Ile dni przechowywać rekordy i zdarzenia
RETENTION_DAYS=30

# Druga warstwa źródeł (zad. 29): off|on; lista serwisów w data/live-sources.json (docs/ZRODLA.md).
LIVE_LAYER=off

# Bramka wsparcia na modelu Basal (domyślnie wyłączona; przy awarii automatycznie Haiku). docs/ZALEZNOSCI.md
# SUPPORT_GATE_PROVIDER=basal
# BASAL_URL=
# BASAL_TOKEN=
# BASAL_TIMEOUT_MS=5000
# BASAL_MIN_CONFIDENCE=0.6
# BASAL_ASSESS=

# Bramka wsparcia na modelu Jev (TypeSafe AI, API w USA; domyślnie wyłączona; przy błędzie albo niskiej pewności Haiku). docs/ZALEZNOSCI.md
# Włącza SUPPORT_GATE_PROVIDER=jev (jedna wartość naraz: basal albo jev) i niepusty JEV_API_KEY.
# JEV_API_KEY=
# JEV_MODEL=jev-1.14.0
# JEV_MIN_CONFIDENCE=0.6
# JEV_TIMEOUT_MS=5000

# Widok urzędnika /urzednik (docs/PETLA_INFORMACJI.md). Bez tokenu (min. 16 znaków) widok zwraca 401.
# URZEDNIK_TOKEN=
# URZEDNIK_OSOBA=
# Adres do powiadomień: przygotowane miejsce, e-maili nie wysyłamy.
# URZEDNIK_ADRES_POWIADOMIEN=
# Po ilu dniach bez nowego zgłoszenia sprawa jest usuwana
# CASE_RETENTION_DAYS=365

# Indeks weryfikacji redakcji (Google Fact Check Tools API, claims:search). docs/ZRODLA.md, docs/ZALEZNOSCI.md
# FACTCHECK_LAYER: auto (domyślnie: włączony, gdy klucz niepusty) | on | off
GOOGLE_FACTCHECK_API_KEY=
# FACTCHECK_LAYER=auto
# FACTCHECK_CONFIG_PATH=data/factcheck.json
# Czas życia rekordu z wpisem z indeksu Google (godziny; 0 = bez zapisu)
# FACTCHECK_RECORD_TTL_HOURS=24

# Kanał Discord (docs/ARCHITEKTURA.md): POST /discord/interactions bez stałego połączenia. Puste = kanał wyłączony (503).
# DISCORD_PUBLIC_KEY weryfikuje podpisy Ed25519; DISCORD_BOT_TOKEN służy tylko skryptowi scripts/discord-register.mjs.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
